# Google OAuth Configuration (for Testing/Live)
GOOGLE_CLIENT_ID=your_client_id_here.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_client_secret_here

# User Credentials (for Live Tests)
GOOGLE_REFRESH_TOKEN=your_refresh_token_here
GOOGLE_ACCESS_TOKEN=your_access_token_here

# Microsoft Entra App Registration (see docs/ops/microsoft-azure-app-registration.md)
MICROSOFT_CLIENT_ID=your_application_client_id_here
MICROSOFT_CLIENT_SECRET=your_client_secret_here
MICROSOFT_REDIRECT_URI=http://localhost:your_port_here/

# Academic Calendar Source
CALENDAR_ID=primary
SEMESTER_START_DATE=2024-08-01
SEMESTER_END_DATE=2024-12-31

# SonarQube (local Quality Gate — see docs/ops/sonarqube-local.md)
SONAR_TOKEN=sqp_your_local_token_here
