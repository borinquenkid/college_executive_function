# eslint-plugin-jsx-a11y@6.10.2's peer range caps at eslint@^9; this project is on eslint@10,
# which is new enough that the plugin hasn't published an updated peer range yet. It works fine
# in practice (verified: npm run lint runs correctly) — this is a peer-range lag, not an actual
# incompatibility. Remove this once jsx-a11y publishes an eslint@10-compatible release.
legacy-peer-deps=true
